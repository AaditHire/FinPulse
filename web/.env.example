# Server-only secrets. Copy to .env.local for local use; never commit .env.local.
GROQ_API_KEY=
# Optional server-side model preference; falls back to an allowed production model.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_TO=recipient@example.com

# Supabase owner-only terminal. Leave all three blank for local compatibility mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_OWNER_ID=
FINPULSE_OWNER_EMAILS=owner@example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal workflows. Use separate long random values in production.
INTERNAL_API_SECRET=
CRON_SECRET=
KEEPALIVE_SECRET=

# Optional equity adapter. FinPulse only contacts data.alpaca.markets.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Official public-data sources. SEC requires an identifying user-agent.
SEC_USER_AGENT=FinPulse Research owner@example.com
FRED_API_KEY=
BLS_API_KEY=
BEA_API_KEY=

# Local 384-dimensional embedding configuration.
EMBEDDING_MODEL=onnx-community/all-MiniLM-L6-v2-ONNX

# Optional OpenAI features remain disabled unless explicitly enabled.
OPENAI_API_KEY=
ENABLE_OPENAI_MODELS=false

# Never enable on a public deployment; useful only for `next start` smoke tests.
ALLOW_INSECURE_LOCAL_MODE=false
ENABLE_TS_DIGEST_SCHEDULER=false
ENABLE_SECOND_SPECIALIST=false
